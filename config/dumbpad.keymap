#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&to 1>;
        };

        td2: td2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD2";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&to 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        calculator {
            bindings = <&kp C_AL_CALC>;
            key-positions = <0 1>;
        };

        calc_2 {
            bindings = <&kp K_CALCULATOR>;
            key-positions = <2 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                            &kp LG(C)        &kp LG(V)        &kp LG(X)       &kp LG(Z)
                            &kp LG(F)        &kp LG(S)        &kp LG(N)       &kp LG(W)
              &kp C_PP      &kp LG(LS(LBKT)) &kp LG(LS(RBKT)) &kp LG(FSLH)    &kp LG(R)
              &kp C_PP      &kp LG(LS(D))    &kp LC(GRAVE)    &td1            &td2
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            bindings = <
                            &kp LG(A)       &kp LA(LS(RIGHT)) &kp LG(L)        &kp LA(UP)
                            &kp LA(DOWN)    &kp LG(D)         &kp LG(LS(K))    &kp TAB
              &kp C_PP      &kp LS(TAB)     &kp LG(LA(DOWN))  &kp LG(LA(LEFT)) &kp LG(LA(RIGHT))
              &kp C_PP      &kp LS(F12)     &kp F2            &to 0            &to 0
            >;

            sensor-bindings =
                <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        layer_2 {
            bindings = <
                            &kp F10         &kp F11           &kp F12         &kp F8
                            &kp F7          &kp F9            &kp LG(LS(N3))  &kp LG(LS(N4))
              &kp C_PP      &kp LC(UP)      &kp LC(DOWN)      &kp F11         &kp LG(LC(Q))
              &kp C_PP      &kp LG(SPACE)   &kp LC(LG(SPACE)) &to 0           &to 0
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};
